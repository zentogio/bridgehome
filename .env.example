# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์ของตัวเอง (ห้าม commit .env.local)
# ทุกค่าเป็นฝั่งเซิร์ฟเวอร์ ห้ามเติม NEXT_PUBLIC_

# เสียงน้องใย (Fish Audio) — ถ้าไม่ใส่ จะใช้เสียงอ่านของเบราว์เซอร์แทน
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free

# สมองน้องใย (ใส่ตัวใดตัวหนึ่งก็พอ ระบบลองตามลำดับ Typhoon → Gemini → Groq)
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TIMEOUT_MS=4500
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
